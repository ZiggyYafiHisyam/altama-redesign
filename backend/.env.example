# Railway sets PORT automatically; only needed for local dev.
PORT=4000

# Comma-separated list of allowed frontend origins, e.g.
# https://your-app.vercel.app,https://your-app-git-preview.vercel.app
CORS_ORIGIN=http://localhost:5173

# Required to read GET /api/contact and GET /api/page-views. Send it back as
# the "x-admin-key" request header. Leave unset to disable these endpoints entirely.
ADMIN_API_KEY=

# Optional: override where contacts.json / pageViews.json are written.
# On Railway, point this at a mounted Volume's path so data survives redeploys
# (e.g. /data). Defaults to backend/data, which is NOT persisted across deploys.
DATA_DIR=
