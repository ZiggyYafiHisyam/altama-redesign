# All of these are optional.

# Local dev only. Vercel and Railway inject PORT automatically; don't set it there.
PORT=4000

# Comma-separated list of allowed frontend origins, e.g.
# https://your-app.vercel.app,https://your-app-git-preview.vercel.app
#
# Unset on Vercel, the API reflects the requesting origin — the frontend is
# served from the same origin there, so nothing needs configuring. Unset
# locally, it allows the Vite dev server (http://localhost:5173).
CORS_ORIGIN=

# --- Admin panel (/admin) --------------------------------------------------
#
# Credentials for signing in at /admin/login. Unset, they fall back to the
# documented defaults admin / 123, which is fine locally and NOT fine on
# anything reachable from the internet -- set both before you deploy.
#
# Note: nothing loads this file locally -- neither package.json passes
# --env-file -- so these take effect on a host that injects env vars (Vercel,
# Railway), not in `npm run dev`.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Key used to sign admin session tokens. Unset, one is derived from the
# username and password, which means every session is invalidated whenever the
# password changes. Set it to any long random string to keep sessions alive
# across a password change, or to share sessions between instances.
ADMIN_SESSION_SECRET=

# How long an admin stays signed in, in hours. Defaults to 12.
ADMIN_SESSION_HOURS=

# Optional machine key for the read-only exports (GET /api/contact and
# GET /api/page-views) without signing in. Send it as the "x-admin-key"
# request header. The admin panel does not need this -- it uses a session.
ADMIN_API_KEY=

# Optional: override where contacts.json, pageViews.json, content.json and
# media.json are written.
# Defaults to /tmp/altama-data on Vercel (ephemeral — wiped when the serverless
# instance is recycled) and to backend/data elsewhere. Point this at a mounted
# volume's path on a host that has persistent disk.
DATA_DIR=
