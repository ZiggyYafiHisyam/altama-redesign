# Base URL of the backend API.
#
# Leave empty for both local dev and the Vercel deployment:
#   - locally, Vite's dev-server proxy forwards /api to localhost:4000
#   - on Vercel, the API is served from the same origin at /api
#
# Only set this if you move the backend to its own host, e.g.
# https://your-app.up.railway.app (no trailing slash).
VITE_API_BASE_URL=
